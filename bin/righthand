#!/usr/bin/env node
const fs = require('fs');
const path = require('path');
const { readState, writeState } = require('../adapters/core/state');

const root = path.resolve(__dirname, '..');
const profilesDir = path.join(root, 'profiles');
const skillsDir = path.join(root, 'skills');

function listProfiles() {
  const out = [];
  if (!fs.existsSync(profilesDir)) return out;
  for (const f of fs.readdirSync(profilesDir)) {
    if (f.endsWith('.md')) {
      out.push(f.slice(0, -3));
    }
  }
  return out.sort();
}

function loadProfile(name) {
  const p = path.join(profilesDir, `${name}.md`);
  if (!fs.existsSync(p)) return null;
  return fs.readFileSync(p, 'utf8');
}

function cmdList() {
  const names = listProfiles();
  const state = readState(process.cwd());
  console.log('RightHand personas:');
  for (const n of names) {
    const mark = state.active === n ? ' [ACTIVE]' : '';
    console.log(`  - ${n}${mark}`);
  }
  console.log('\nUsage: righthand <name> | righthand list | righthand off | righthand inject');
}

function cmdSwitch(name) {
  const names = listProfiles();
  if (!names.includes(name)) {
    console.error(`Unknown persona: ${name}`);
    console.error(`Available: ${names.join(', ')}`);
    process.exit(1);
  }
  writeState({ active: name, updatedAt: new Date().toISOString() }, process.cwd());
  console.log(`Active persona set to: ${name}`);
}

function cmdOff() {
  writeState({ active: null, updatedAt: new Date().toISOString() }, process.cwd());
  console.log('Persona deactivated');
}

function cmdInject() {
  const state = readState(process.cwd());
  if (!state.active) {
    return;
  }
  const raw = loadProfile(state.active);
  if (!raw) return;
  const m = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/.exec(raw);
  const body = m ? m[2] : raw;
  console.log(`## Active RightHand persona: ${state.active}\n\n${body.trim()}\n`);
}

const [,, cmd, arg] = process.argv;
if (!cmd || cmd === 'list') cmdList();
else if (cmd === 'off') cmdOff();
else if (cmd === 'inject') cmdInject();
else if (cmd === 'switch') cmdSwitch(arg);
else cmdSwitch(cmd);
